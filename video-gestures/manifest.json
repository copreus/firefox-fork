{
  "manifest_version": 2,
  "name": "Video Gestures",
  "version": "0.1.0",
  "description": "Floating video toolbar plus a fullscreen gesture player: drag to seek, left side for brightness, right side for volume.",
  "browser_specific_settings": {
    "gecko": {
      "id": "video-gestures@firefox-fork",
      "strict_min_version": "115.0"
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
